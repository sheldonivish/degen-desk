<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.degendesk.autopilot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.degen-desk/autopilot/run.sh</string>
    <string>__MODE__</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.degen-desk/autopilot</string>
  <key>RunAtLoad</key><true/>
  <!-- restart after a crash, but NOT after a clean exit (kill switch / missing key) -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/.degen-desk/autopilot/daemon.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.degen-desk/autopilot/daemon.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
